{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default"}, "_meta": {"title": "Klein 4B distilled BF16"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "flux2-vae-klein.safetensors"}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "Change the limestone to warm reddish sandstone while preserving the arrangement, shapes, and mortar joints. Keep the surface evenly lit, with realistic fine mineral grain.", "clip": ["2", 0]}, "_meta": {"title": "Editing prompt"}},
  "5": {"class_type": "EmptyFlux2LatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}, "_meta": {"title": "Output dimensions"}},
  "6": {"class_type": "RandomNoise", "inputs": {"noise_seed": 43}, "_meta": {"title": "Seed"}},
  "7": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "8": {"class_type": "Flux2Scheduler", "inputs": {"steps": 4, "width": 1024, "height": 1024}, "_meta": {"title": "Keep dimensions in sync with node 5"}},
  "9": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["4", 0]}},
  "10": {"class_type": "CFGGuider", "inputs": {"model": ["1", 0], "positive": ["17", 0], "negative": ["18", 0], "cfg": 1.0}},
  "11": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["6", 0], "guider": ["10", 0], "sampler": ["7", 0], "sigmas": ["8", 0], "latent_image": ["5", 0]}},
  "12": {"class_type": "VAEDecode", "inputs": {"samples": ["11", 0], "vae": ["3", 0]}},
  "13": {"class_type": "SaveImage", "inputs": {"images": ["12", 0], "filename_prefix": "klein/reference-edit"}},
  "14": {"class_type": "LoadImage", "inputs": {"image": "reference.png"}, "_meta": {"title": "Filename returned by /upload/image"}},
  "15": {"class_type": "ImageScaleToTotalPixels", "inputs": {"image": ["14", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 16}},
  "16": {"class_type": "VAEEncode", "inputs": {"pixels": ["15", 0], "vae": ["3", 0]}},
  "17": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["4", 0], "latent": ["16", 0]}},
  "18": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["9", 0], "latent": ["16", 0]}}
}
