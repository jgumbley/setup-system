#!/usr/bin/env bash
# Shared lifecycle contract for controller-driven Sunshine applications.

game_session_message_pid=""
game_session_controller_dir=""
declare -A game_session_controller_monitors=()

game_session_cleanup_message() {
  if [[ -n "${game_session_message_pid}" ]] && kill -0 -- "-${game_session_message_pid}" 2>/dev/null; then
    kill -- "-${game_session_message_pid}" 2>/dev/null || true
    wait "${game_session_message_pid}" 2>/dev/null || true
  fi
  game_session_message_pid=""
}

game_session_cleanup_controller_wait() {
  local monitor_pid

  game_session_cleanup_message
  for monitor_pid in "${game_session_controller_monitors[@]:-}"; do
    [[ -n "${monitor_pid}" ]] || continue
    kill -- "-${monitor_pid}" 2>/dev/null || true
    wait "${monitor_pid}" 2>/dev/null || true
  done
  game_session_controller_monitors=()
  if [[ -n "${game_session_controller_dir}" && -d "${game_session_controller_dir}" ]]; then
    rm -rf -- "${game_session_controller_dir}" 2>/dev/null || true
  fi
  game_session_controller_dir=""
}

game_session_abort_wait() {
  game_session_cleanup_controller_wait
  exit 143
}

game_session_show_error() {
  local title="$1"
  local message="$2"
  local exit_status="${3:-1}"

  game_session_cleanup_controller_wait
  printf '[%s] %s: %s\n' "$(date --iso-8601=seconds)" "${title}" "${message}" >&2
  GAME_SESSION_ERROR_TITLE="${title}" GAME_SESSION_ERROR_MESSAGE="${message}" \
    /usr/bin/setsid /usr/bin/bash -c 'exec 9>&-; exec "$@"' game-session-error \
    /usr/bin/foot \
      --app-id=game-session-error \
      --title="${title}" \
      --font="DejaVu Sans Mono:size=24" \
      /usr/bin/bash -c '
        printf "\033[2J\033[H\n  \033[1;31m%s\033[0m\n\n  %s\n\n  This message will close in 10 seconds.\n" \
          "$GAME_SESSION_ERROR_TITLE" "$GAME_SESSION_ERROR_MESSAGE"
        exec /usr/bin/sleep 10
      ' &
  game_session_message_pid=$!
  trap game_session_abort_wait HUP INT TERM
  wait "${game_session_message_pid}" 2>/dev/null || true
  game_session_cleanup_message
  trap - HUP INT TERM
  exit "${exit_status}"
}

game_session_start_controller_monitor() {
  local event_device="$1"
  local event_name="${event_device##*/}"
  local ready_file="${game_session_controller_dir}/ready"
  local monitor_pid="${game_session_controller_monitors[${event_name}]:-}"

  if [[ -n "${monitor_pid}" ]] && kill -0 "${monitor_pid}" 2>/dev/null; then
    return
  fi
  if [[ -n "${monitor_pid}" ]]; then
    wait "${monitor_pid}" 2>/dev/null || true
  fi

  GAME_SESSION_EVENT_DEVICE="${event_device}" GAME_SESSION_READY_FILE="${ready_file}" \
    /usr/bin/setsid /usr/bin/bash -c '
    exec 9>&-
    set +e
    set +o pipefail
    if /usr/bin/timeout 30s /usr/bin/stdbuf -oL /usr/bin/evtest "${GAME_SESSION_EVENT_DEVICE}" 2>/dev/null |
      /usr/bin/grep -m1 -E '^Event: .*type 1 \(EV_KEY\), code [0-9]+ \(BTN_[A-Z0-9_]+\), value 1$' >/dev/null; then
      (
        set -o noclobber
        printf '%s\n' "${GAME_SESSION_EVENT_DEVICE}" > "${GAME_SESSION_READY_FILE}"
      ) 2>/dev/null || true
    fi
  ' &
  game_session_controller_monitors[${event_name}]=$!
}

game_session_wait_for_controller() {
  local title="$1"
  local deadline=$((SECONDS + 30))
  local event_name event_device name_file

  if ! game_session_controller_dir="$(mktemp -d "{{ sunshine_host_runtime_dir }}/controller-wait.XXXXXX")"; then
    game_session_show_error \
      "${title}: SESSION ERROR" \
      "The private controller-wait directory could not be created."
  fi
  trap game_session_abort_wait HUP INT TERM
  trap game_session_cleanup_controller_wait EXIT

  GAME_SESSION_WAIT_TITLE="${title}" \
    /usr/bin/setsid /usr/bin/bash -c 'exec 9>&-; exec "$@"' game-session-controller \
    /usr/bin/foot \
    --app-id=game-session-controller-required \
    --title="${title}: controller required" \
    --font="DejaVu Sans Mono:size=24" \
    /usr/bin/bash -c '
      printf "\033[2J\033[H\n  \033[1;33m%s: CONTROLLER REQUIRED\033[0m\n\n  Connect or enable a controller in Moonlight.\n  Press any controller button to continue.\n\n  This launch attempt will close after 30 seconds.\n" "$GAME_SESSION_WAIT_TITLE"
      exec /usr/bin/sleep infinity
    ' &
  game_session_message_pid=$!

  printf '[%s] Waiting for a button press from a Sunshine virtual Xbox controller.\n' \
    "$(date --iso-8601=seconds)"
  while (( SECONDS < deadline )); do
    kill -0 "${game_session_message_pid}" 2>/dev/null || \
      game_session_show_error "${title}: DISPLAY ERROR" "The controller prompt exited unexpectedly."

    for name_file in /sys/class/input/event*/device/name; do
      [[ -r "${name_file}" ]] || continue
      case "$(<"${name_file}")" in
        Sunshine\ X-Box\ One\ \(virtual\)\ pad*)
          event_name="${name_file#/sys/class/input/}"
          event_name="${event_name%%/*}"
          event_device="/dev/input/${event_name}"
          [[ -r "${event_device}" ]] || continue
          game_session_start_controller_monitor "${event_device}"
          ;;
      esac
    done

    if [[ -s "${game_session_controller_dir}/ready" ]]; then
      GAME_SESSION_CONTROLLER="$(<"${game_session_controller_dir}/ready")"
      game_session_cleanup_controller_wait
      trap - EXIT HUP INT TERM
      printf '[%s] Controller input confirmed on %s.\n' \
        "$(date --iso-8601=seconds)" "${GAME_SESSION_CONTROLLER}"
      return
    fi
    sleep 0.2
  done

  game_session_show_error \
    "${title}: NO CONTROLLER DETECTED" \
    "No controller button press reached Holly. The game was not started."
}

game_session_acquire() {
  local title="$1"

  exec 9>"{{ sunshine_host_runtime_dir }}/game-session.lock" || \
    game_session_show_error "${title}: SESSION ERROR" "The game-session lock could not be opened."
  if ! /usr/bin/flock -n 9; then
    game_session_show_error "${title}: SESSION BUSY" "Another game or ROCKNIX session is already active."
  fi
}

game_session_begin() {
  local title="$1"

  game_session_acquire "${title}"
  game_session_wait_for_controller "${title}"
}

game_session_require_command() {
  local command_path="$1"
  local title="$2"
  [[ -x "${command_path}" ]] || \
    game_session_show_error "${title}: RUNTIME MISSING" "Run the matching game_runtimes build or install target first."
}

game_session_require_runtime() {
  local runtime_dir="$1"
  local command_path="$2"
  local title="$3"

  [[ -L "${runtime_dir%/current}/current" ]] || \
    game_session_show_error "${title}: RUNTIME MISSING" "The validated current runtime selector is absent."
  [[ -f "${runtime_dir}/.setup-system-runtime" && \
     ! -L "${runtime_dir}/.setup-system-runtime" && \
     -s "${runtime_dir}/.setup-system-runtime" ]] || \
    game_session_show_error "${title}: RUNTIME INVALID" "The runtime validation marker is absent."
  game_session_require_command "${command_path}" "${title}"
}

game_session_require_runtime_contract() {
  local runtime_dir="$1"
  local title="$2"
  local expected_runtime="$3"
  local expected_version="$4"
  local expected_revision="$5"
  local expected_source_sha256="$6"
  local expected_patch_sha256="$7"
  local marker="${runtime_dir}/.setup-system-runtime"

  [[ "$(game_session_marker_value "${marker}" runtime)" == "${expected_runtime}" &&
     "$(game_session_marker_value "${marker}" version)" == "${expected_version}" &&
     "$(game_session_marker_value "${marker}" revision)" == "${expected_revision}" &&
     "$(game_session_marker_value "${marker}" source_sha256)" == "${expected_source_sha256}" &&
     "$(game_session_marker_value "${marker}" patch_sha256)" == "${expected_patch_sha256}" ]] || \
    game_session_show_error \
      "${title}: RUNTIME INVALID" \
      "The installed runtime does not match the setup-system version contract."
}

game_session_require_nas() {
  local title="$1"
  local mount_record

  if ! /usr/bin/timeout 3s /usr/bin/bash -c 'exec 3<>/dev/tcp/donatello.smeg/2049'; then
    game_session_show_error "${title}: NAS UNAVAILABLE" "Iceburg did not answer on NFS before the mount was accessed."
  fi
  if ! /usr/bin/timeout 10s /usr/bin/stat -L "{{ sunshine_host_nas_mount_dir }}/roms" >/dev/null; then
    game_session_show_error "${title}: NAS UNAVAILABLE" "The persistent Iceburg automount did not become ready."
  fi
  mount_record="$(/usr/bin/timeout 3s /usr/bin/findmnt -T "{{ sunshine_host_nas_mount_dir }}/roms" -n -t nfs,nfs4 -o SOURCE,FSTYPE 2>/dev/null || true)"
  [[ "${mount_record}" == "{{ sunshine_host_nas_source }} nfs" || "${mount_record}" == "{{ sunshine_host_nas_source }} nfs4" ]] || \
    game_session_show_error "${title}: NAS INVALID" "Iceburg is not mounted from {{ sunshine_host_nas_source }}."
}

game_session_require_writable_dir() {
  local directory="$1"
  local title="$2"
  [[ -d "${directory}" && -r "${directory}" && -w "${directory}" && -x "${directory}" ]] || \
    game_session_show_error "${title}: STATE ERROR" "The local game-state directory is unavailable."
}

game_session_require_file() {
  local path="$1"
  local title="$2"
  [[ -s "${path}" ]] || \
    game_session_show_error "${title}: CONTENT MISSING" "Required game content is missing: ${path##*/}"
}

game_session_require_sha256() {
  local expected="$1"
  local path="$2"
  local title="$3"
  local actual

  game_session_require_file "${path}" "${title}"
  actual="$(/usr/bin/timeout 90s /usr/bin/sha256sum -- "${path}" | /usr/bin/awk '{print $1}')" || \
    game_session_show_error "${title}: CONTENT ERROR" "Content verification did not complete: ${path##*/}"
  [[ "${actual}" == "${expected}" ]] || \
    game_session_show_error "${title}: CONTENT INVALID" "Content checksum failed: ${path##*/}"
}

game_session_marker_value() {
  local marker="$1"
  local key="$2"
  /usr/bin/awk -F= -v key="${key}" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "${marker}"
}
