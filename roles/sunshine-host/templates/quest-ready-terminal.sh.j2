#!/usr/bin/env bash
set -euo pipefail

state_dir="{{ sunshine_host_state_dir }}"
game_cache_dir="{{ sunshine_host_game_cache_dir }}"
printf '\033]2;%s\007' "Sunshine Host"
clear 2>/dev/null || true

cat <<EOF
Sunshine host is ready.

Moonlight is connected to the headless Sway display.
Launch "philby", "camera", "morrowind", "quake3", "rocknix", or "steam" from Moonlight.

Runtime logs:
  $state_dir/philby.log
  $state_dir/camera.log
  $game_cache_dir/morrowind/native/session.log
  $game_cache_dir/quake3/session.log
  $game_cache_dir/rocknix/session.log
  $state_dir/steam.log

EOF

for log in \
  "$state_dir/philby.log" \
  "$state_dir/camera.log" \
  "$game_cache_dir/morrowind/native/session.log" \
  "$game_cache_dir/quake3/session.log" \
  "$game_cache_dir/rocknix/session.log" \
  "$state_dir/steam.log"; do
  if [ -s "$log" ]; then
    printf 'Last lines from %s:\n' "$log"
    tail -n 12 "$log" || true
    printf '\n'
  fi
done

exec "${SHELL:-/usr/bin/bash}"
