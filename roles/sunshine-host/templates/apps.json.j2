{
  "env": {
    "PATH": "{{ sunshine_host_app_path }}"
  },
  "apps": [
    {
      "name": "philby",
      "cmd": "{{ sunshine_host_install_dir }}/bin/quest-philby-app.sh",
      "working-dir": "{{ sunshine_host_philby_dir }}",
      "output": "{{ sunshine_host_state_dir }}/philby.log",
      "wait-all": true,
      "exit-timeout": 5,
      "auto-detach": false,
      "image-path": "{{ sunshine_host_config_dir }}/covers/philby.png"
    },
    {
      "name": "camera",
      "cmd": "{{ sunshine_host_install_dir }}/bin/quest-camera-app.sh",
      "working-dir": "{{ sunshine_host_home }}",
      "output": "{{ sunshine_host_state_dir }}/camera.log",
      "wait-all": true,
      "exit-timeout": 5,
      "auto-detach": false,
      "image-path": "{{ sunshine_host_config_dir }}/covers/camera.png"
    },
    {
      "name": "morrowind",
      "cmd": "{{ sunshine_host_install_dir }}/bin/run-morrowind-openmw.sh",
      "working-dir": "{{ sunshine_host_install_dir }}",
      "output": "{{ sunshine_host_game_cache_dir }}/morrowind/native/session.log",
      "wait-all": true,
      "exit-timeout": 10,
      "auto-detach": false,
      "image-path": "{{ sunshine_host_config_dir }}/covers/morrowind.png"
    },
    {
      "name": "quake3",
      "cmd": "{{ sunshine_host_install_dir }}/bin/run-quake3.sh",
      "working-dir": "{{ sunshine_host_install_dir }}",
      "output": "{{ sunshine_host_game_cache_dir }}/quake3/session.log",
      "wait-all": true,
      "exit-timeout": 10,
      "auto-detach": false,
      "image-path": "{{ sunshine_host_config_dir }}/covers/quake3.png"
    },
    {
      "name": "rocknix",
      "cmd": "{{ sunshine_host_install_dir }}/bin/run-rocknix.sh",
      "working-dir": "{{ sunshine_host_install_dir }}",
      "output": "{{ sunshine_host_game_cache_dir }}/rocknix/session.log",
      "wait-all": true,
      "exit-timeout": 10,
      "auto-detach": false,
      "image-path": "{{ sunshine_host_config_dir }}/covers/rocknix.png"
    },
    {
      "name": "steam",
      "detached": [
        "/usr/bin/env HOME={{ sunshine_host_home }} DISPLAY=:0 /usr/bin/setsid steam steam://open/bigpicture"
      ],
      "working-dir": "{{ sunshine_host_home }}",
      "output": "{{ sunshine_host_state_dir }}/steam.log",
      "image-path": "{{ sunshine_host_config_dir }}/covers/steam.png"
    }
  ]
}
